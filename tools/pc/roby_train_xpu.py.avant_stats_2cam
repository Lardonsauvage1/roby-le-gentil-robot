#!/usr/bin/env python3
"""Entrainement Diffusion Policy sur iGPU Arc (XPU), a BUDGET DE TEMPS fixe par modele.

Balaye plusieurs tailles SEQUENTIELLEMENT, du plus gros au plus petit, chacune --hours heures.

RECETTE COPIEE de cart_combined_128 (le gros modele cartesien qui marche), a l'identique :
  backbone resnet18 SANS poids pre-entraines (lui aussi partait de zero), crop 112 aleatoire,
  group norm, spatial softmax 32 keypoints, kernel 5, n_groups 8, embed 128, FiLM,
  DDPM 100 pas, beta squaredcos_cap_v2 (1e-4 -> 0.02), prediction epsilon, clip_sample,
  n_obs_steps=2, horizon=16, n_action_steps=8, drop_n_last_frames=7,
  normalisation VISUAL=MEAN_STD / STATE=MIN_MAX / ACTION=MIN_MAX,
  Adam (PAS AdamW) lr 1e-4 betas (0.95,0.999) eps 1e-8 wd 1e-6, grad_clip_norm 10.0,
  batch 64, seed 42.  (leur scheduler etait cosine+warmup ; ici LR constant, voir DEVIATIONS)

PAS DE VALIDATION : on entraine sur les 111 episodes, comme la reference (choix de Sam).
Les courbes produites sont donc train-loss et norme du gradient, il n'y a pas de val-loss.
Historique fin dans <sortie>/<taille>/metrics.csv -> tracer avec roby_plot_training.py

SEULE VARIABLE : down_dims (largeur de l'U-Net). C'est ce qui rend l'inference et
l'entrainement plus rapides quand on descend en taille.

DEVIATIONS ASSUMEES (et pourquoi) :
  - LR **CONSTANT** 1e-4 du debut a la fin (choix de Sam) : ni warmup, ni cosine, ni cooldown.
    Le role du recuit est tenu par la MOYENNE DES POIDS des N derniers snapshots
    (--avg-last, defaut 8, un toutes les --snap-every minutes) -> checkpoint
    `pretrained_model_avg`. A LR constant les poids oscillent autour du minimum ;
    les moyenner ramene au centre du bassin.
  - EMA decay 0.999 (adapte a des runs de quelques milliers de pas).

PREREQUIS : source ~/roby_xpu_env.sh (en-tetes Level Zero -> torch.compile = +41 %)
"""
import argparse
import copy
import json
import math
import time
from pathlib import Path

import torch

# Du plus GROS au plus petit. Le premier = archi exacte de cart_combined_128.
TAILLES = [
    ("263M", (512, 1024, 2048)),
    ("78M", (256, 512, 1024)),
    ("28M", (128, 256, 512)),
    ("16M", (64, 128, 256)),
]

# Recette de reference, copiee telle quelle (hors down_dims et hors poids).
REF = dict(
    vision_backbone="resnet18",
    pretrained_backbone_weights=None,
    crop_shape=(112, 112),
    crop_is_random=True,
    use_group_norm=True,
    spatial_softmax_num_keypoints=32,
    use_separate_rgb_encoder_per_camera=False,
    kernel_size=5,
    n_groups=8,
    diffusion_step_embed_dim=128,
    use_film_scale_modulation=True,
    noise_scheduler_type="DDPM",
    num_train_timesteps=100,
    beta_schedule="squaredcos_cap_v2",
    beta_start=0.0001,
    beta_end=0.02,
    prediction_type="epsilon",
    clip_sample=True,
    clip_sample_range=1.0,
    num_inference_steps=10,
    n_obs_steps=2,
    horizon=16,
    n_action_steps=8,
    drop_n_last_frames=7,
)


def build(root, down_dims, batch, workers):
    from lerobot.datasets.feature_utils import dataset_to_policy_features
    from lerobot.datasets.lerobot_dataset import LeRobotDataset, LeRobotDatasetMetadata
    from lerobot.datasets.sampler import EpisodeAwareSampler
    from lerobot.configs.types import FeatureType
    from lerobot.policies.diffusion.configuration_diffusion import DiffusionConfig
    from lerobot.policies.diffusion.modeling_diffusion import DiffusionPolicy

    meta = LeRobotDatasetMetadata(repo_id="local/x", root=root)
    feats = dataset_to_policy_features(meta.features)
    out_f = {k: v for k, v in feats.items() if v.type is FeatureType.ACTION}
    in_f = {k: v for k, v in feats.items() if k not in out_f}

    cfg = DiffusionConfig(input_features=in_f, output_features=out_f,
                          down_dims=tuple(down_dims), **REF)

    delta = {}
    if cfg.observation_delta_indices is not None:
        for k in in_f:
            delta[k] = [i / meta.fps for i in cfg.observation_delta_indices]
    if cfg.action_delta_indices is not None:
        delta["action"] = [i / meta.fps for i in cfg.action_delta_indices]

    ds = LeRobotDataset(repo_id="local/x", root=root, delta_timestamps=delta, video_backend="pyav")

    # meme echantillonnage que la reference : on ne tire pas dans les 7 dernieres frames
    sampler = EpisodeAwareSampler(
        ds.meta.episodes["dataset_from_index"],
        ds.meta.episodes["dataset_to_index"],
        episode_indices_to_use=ds.episodes,
        drop_n_last_frames=cfg.drop_n_last_frames,
        shuffle=True,
    )
    dl = torch.utils.data.DataLoader(
        ds, batch_size=batch, sampler=sampler, num_workers=workers, drop_last=True,
        pin_memory=True, persistent_workers=True, prefetch_factor=4,
    )
    # on ECRASE meta.stats : c est lui qui sert AUSSI a save() pour fabriquer les
    # pre/post-processeurs. Sans ca le modele serait entraine avec les bonnes stats
    # mais sauvegarde avec les fausses -> aveugle a l inference.
    meta.stats = corriger_stats_image(meta.stats, ds)
    pol = DiffusionPolicy(cfg, dataset_stats=meta.stats)
    return cfg, meta, ds, pol, dl


def corriger_stats_image(stats, ds, n_ech=60):
    """⚠️ CORRECTIF (2026-07-28) : l ecart-type image renvoye par LeRobot est FAUX.

    Mesure : LeRobot annonce std=[0.0148 0.0082 0.0245] la ou le vrai ecart-type des
    PIXELS vaut [0.2399 0.1861 0.1260] -- 16 a 23x trop petit (ce n est pas l ecart-type
    des pixels mais celui des moyennes par image, qui varie tres peu).

    Consequence si on ne corrige pas : la normalisation (x-mean)/std amplifie les images
    d un facteur ~20. Le ResNet recoit du +/-40 au lieu de +/-2, sature, et sa sortie
    devient constante -> le reseau IGNORE l image et se rabat sur la pose TCP.
    C est ce qui rendait nos modeles inutilisables (89 mm d erreur contre 2 mm pour la
    reference, qui utilise elle les stats ImageNet [0.229 0.224 0.225]).

    Ici on recalcule les vraies stats sur un echantillon d images du dataset.
    """
    import numpy as np

    stats = {k: dict(v) for k, v in stats.items()}
    cle = [k for k in stats if "image" in k]
    if not cle:
        return stats
    k = cle[0]
    pas = max(len(ds) // n_ech, 1)
    px = np.stack([ds[i][k].numpy() for i in range(0, len(ds), pas)][:n_ech])
    # avec delta_timestamps l image porte une dimension n_obs_steps en plus :
    # la forme est (N, n_obs, 3, H, W) et non (N, 3, H, W). On aplatit tout ce qui
    # precede les 3 dernieres dimensions pour retomber sur (M, 3, H, W).
    px = px.reshape(-1, *px.shape[-3:])
    mean = px.mean(axis=(0, 2, 3))
    std = px.std(axis=(0, 2, 3))
    forme = np.asarray(stats[k]["std"]).shape
    ancien = np.asarray(stats[k]["std"]).ravel()
    stats[k]["mean"] = mean.reshape(forme).astype(np.float32)
    stats[k]["std"] = std.reshape(forme).astype(np.float32)
    print(f"    stats image CORRIGEES : std {np.round(ancien,4)} (LeRobot, faux) "
          f"-> {np.round(std,4)} (pixels reels)", flush=True)
    return stats


class EMA:
    """Moyenne exponentielle. Le shadow reste SUR LE GPU en fp32 : le copier vers le CPU
    a chaque pas couterait ~1 Go de transfert par pas sur le modele 263M."""

    def __init__(self, model, decay):
        self.decay = decay
        self.shadow = {k: v.detach().clone().float()
                       for k, v in model.state_dict().items() if v.dtype.is_floating_point}
        self.buffers = {k: v.detach().clone()
                        for k, v in model.state_dict().items() if not v.dtype.is_floating_point}

    @torch.no_grad()
    def update(self, model):
        d = self.decay
        for k, v in model.state_dict().items():
            if k in self.shadow:
                self.shadow[k].mul_(d).add_(v.detach().float(), alpha=1 - d)
            else:
                self.buffers[k] = v.detach().clone()

    def state_dict_cpu(self):
        sd = {k: v.detach().cpu().clone() for k, v in self.shadow.items()}
        sd.update({k: v.detach().cpu().clone() for k, v in self.buffers.items()})
        return sd


def lr_at(elapsed, budget, step, base_lr, mode):
    """Deux regimes :
      - "constant" : LR fixe du debut a la fin (entrainement principal, choix de Sam).
        Le recuit est alors assure par la MOYENNE DES POIDS des derniers snapshots.
      - "cosine"   : LR -> 0 sur le budget = phase de COOLDOWN, comme la reference
        (qui faisait 40k pas a LR constant puis 5k de cooldown)."""
    if mode == "cosine":
        frac = min(max(elapsed / budget, 0.0), 1.0)
        return base_lr * 0.5 * (1.0 + math.cos(math.pi * frac))
    return base_lr


class Moyenne:
    """Moyenne des poids des N derniers snapshots d'entrainement.

    A LR constant, les poids oscillent autour d'un minimum sans jamais s'y poser ; moyenner
    plusieurs points de la trajectoire ramene au centre du bassin. C'est ce qui remplace
    le cooldown (LR -> 0) de la recette d'origine.
    Les snapshots sont gardes sur CPU en fp32 (263M ~ 1 Go chacun, RAM de 93 Go : large)."""

    def __init__(self, n_max):
        self.n_max = n_max
        self.snaps = []

    @torch.no_grad()
    def snapshot(self, model):
        sd = model.state_dict()
        # on ne moyenne QUE les tensors flottants ; les buffers entiers (compteurs, indices)
        # seraient corrompus par une division -> on gardera ceux du dernier snapshot
        self.snaps.append({
            "flottants": {k: v.detach().float().cpu().clone()
                          for k, v in sd.items() if v.dtype.is_floating_point},
            "entiers": {k: v.detach().cpu().clone()
                        for k, v in sd.items() if not v.dtype.is_floating_point},
        })
        if len(self.snaps) > self.n_max:
            self.snaps.pop(0)

    @torch.no_grad()
    def moyenne(self):
        if not self.snaps:
            return None
        acc = {k: v.clone() for k, v in self.snaps[0]["flottants"].items()}
        for s in self.snaps[1:]:
            for k in acc:
                acc[k] += s["flottants"][k]
        n = len(self.snaps)
        for k in acc:
            acc[k] /= n
        acc.update(self.snaps[-1]["entiers"])  # buffers entiers : ceux du dernier snapshot
        return acc

    def __len__(self):
        return len(self.snaps)


def save(pol_raw, ema, cfg, outdir, info, moy=None):
    from lerobot.policies.factory import make_pre_post_processors

    outdir.mkdir(parents=True, exist_ok=True)
    # checkpoint courant, en fp32 sur CPU
    base = copy.deepcopy(pol_raw).float().cpu()
    base.save_pretrained(outdir / "pretrained_model")
    # checkpoint EMA
    ema_model = copy.deepcopy(pol_raw).cpu()
    ema_model.load_state_dict(ema.state_dict_cpu(), strict=False)
    ema_model = ema_model.float()  # fp32 APRES le chargement : sinon load_state_dict
    ema_model.save_pretrained(outdir / "pretrained_model_ema")  # laisse des tensors en bf16
    # moyenne des poids des N derniers snapshots (remplace le cooldown)
    dossiers = ["pretrained_model", "pretrained_model_ema"]
    if moy is not None and len(moy) > 0:
        avg_model = copy.deepcopy(pol_raw).cpu()
        avg_model.load_state_dict(moy.moyenne(), strict=False)
        avg_model = avg_model.float()  # idem : fp32 force APRES le chargement
        avg_model.save_pretrained(outdir / "pretrained_model_avg")
        info["snapshots_moyennes"] = len(moy)
        dossiers.append("pretrained_model_avg")
    # pre/post processeurs : OBLIGATOIRES a l'inference (cf INDEX.md des modeles deployes)
    try:
        pre, post = make_pre_post_processors(cfg, dataset_stats=info.get("_stats"))
        for d in dossiers:
            pre.save_pretrained(outdir / d)
            post.save_pretrained(outdir / d)
    except Exception as e:
        info["avertissement_processors"] = f"{type(e).__name__}: {e}"
    info.pop("_stats", None)
    (outdir / "train_info.json").write_text(json.dumps(info, indent=2))


def train_one(nom, down_dims, a, log):
    import intel_extension_for_pytorch as ipex

    torch.manual_seed(a.seed)
    t_start = time.time()
    cfg, meta, ds, pol, dl = build(a.root, down_dims, a.batch, a.workers)
    if a.init_from:
        from safetensors.torch import load_file
        src = Path(a.init_from).expanduser() / nom / "pretrained_model"
        manquants, inattendus = pol.load_state_dict(load_file(src / "model.safetensors"), strict=False)
        log(f"    reprise depuis {src} (manquants={len(manquants)}, inattendus={len(inattendus)})")
    n_par = sum(p.numel() for p in pol.parameters()) / 1e6
    log(f"\n{'='*72}\n### {nom}  down_dims={down_dims}  ->  {n_par:.1f}M parametres")
    log(f"    {len(ds)} echantillons | batch {a.batch} | budget {a.hours} h | seed {a.seed}")

    pol = pol.to("xpu").train()
    # ATTENTION : la reference utilise "adam" (pas adamw) -> weight_decay en penalite L2,
    # pas en decouple. Verifie dans son train_config.json.
    opt = torch.optim.Adam(pol.parameters(), lr=a.lr, betas=(0.95, 0.999),
                           eps=1e-8, weight_decay=1e-6)
    tdtype = torch.bfloat16 if a.dtype == "bf16" else torch.float32
    pol, opt = ipex.optimize(pol, optimizer=opt, dtype=tdtype)
    log(f"    precision = {a.dtype}")
    pol_raw = pol  # EMA et sauvegarde passent par le module non compile
    ema = EMA(pol_raw, decay=a.ema_decay)
    moy = Moyenne(a.avg_last)
    fwd = pol_raw
    if not a.no_compile:
        try:
            fwd = torch.compile(pol_raw, backend="inductor")
            log("    torch.compile(inductor) actif (+41 % mesure)")
        except Exception as e:
            log(f"    torch.compile indisponible ({type(e).__name__}) -> sans")

    outdir = Path(a.out).expanduser() / nom
    outdir.mkdir(parents=True, exist_ok=True)
    # historique fin pour tracer les courbes (loss + norme du gradient)
    fmetrics = open(outdir / "metrics.csv", "w", buffering=1)
    fmetrics.write("step,temps_s,loss,grad_norm,lr\n")
    budget = a.hours * 3600
    it = iter(dl)
    step, losses, gnorms = 0, [], []
    last_log = last_save = last_snap = time.time()
    last_log_step = 0
    t_first = None

    while True:
        el = time.time() - t_start
        if el >= budget:
            break
        try:
            b = next(it)
        except StopIteration:
            it = iter(dl)
            b = next(it)
        b = {k: (v.to("xpu", non_blocking=True) if torch.is_tensor(v) else v) for k, v in b.items()}
        lr = lr_at(el, budget, step, a.lr, a.lr_schedule)
        for g in opt.param_groups:
            g["lr"] = lr
        opt.zero_grad(set_to_none=True)
        if a.dtype == "bf16":
            with torch.autocast(device_type="xpu", dtype=torch.bfloat16):
                out = fwd.forward(b)
        else:
            out = fwd.forward(b)   # fp32 pur : pas d autocast
        loss = out[0] if isinstance(out, (tuple, list)) else out["loss"]
        loss.backward()
        # ecretage a 10.0 comme la reference (grad_clip_norm). Bonus : clip_grad_norm_ RENVOIE
        # la norme totale AVANT ecretage -> c'est notre metrique de gradient, gratuite.
        gnorm = torch.nn.utils.clip_grad_norm_(pol_raw.parameters(), a.grad_clip)
        opt.step()
        ema.update(pol_raw)
        step += 1
        if step == 1:
            t_first = time.time()  # fin de la compilation
        lv = loss.detach().float().item()
        losses.append(lv)
        gv = float(gnorm)
        gnorms.append(gv)
        if step % a.metrics_every == 0:
            fmetrics.write(f"{step},{el:.2f},{lv:.6f},{gv:.6f},{lr:.3e}\n")

        if time.time() - last_log > a.log_every:
            m = sum(losses[-200:]) / len(losses[-200:])
            # debit RECENT (hors compilation initiale), plus parlant que le cumul
            recent = (step - last_log_step) / (time.time() - last_log)
            g = sum(gnorms[-200:]) / len(gnorms[-200:])
            log(f"    [{nom}] {el/60:6.1f}/{budget/60:.0f} min | pas {step:6d} | "
                f"loss(200) {m:.5f} | grad(200) {g:.3f} | lr {lr:.2e} | {recent:.3f} pas/s")
            last_log = time.time()
            last_log_step = step

        if time.time() - last_snap > a.snap_every * 60:
            moy.snapshot(pol_raw)
            log(f"    [{nom}] snapshot pour moyenne ({len(moy)}/{a.avg_last}) a {step} pas")
            last_snap = time.time()

        if time.time() - last_save > a.save_every * 60:
            save(pol_raw, ema, cfg, outdir,
                 {"nom": nom, "down_dims": list(down_dims), "params_M": round(n_par, 1),
                  "steps": step, "elapsed_min": round(el / 60, 1), "partiel": True,
                  "loss_200": round(sum(losses[-200:]) / len(losses[-200:]), 5),
                  "_stats": meta.stats}, moy=moy)
            log(f"    [{nom}] checkpoint intermediaire a {step} pas")
            last_save = time.time()

    el = time.time() - t_start
    info = {"nom": nom, "down_dims": list(down_dims), "params_M": round(n_par, 1),
            "steps": step, "elapsed_min": round(el / 60, 1),
            "loss_debut": round(sum(losses[:200]) / max(len(losses[:200]), 1), 5),
            "loss_fin": round(sum(losses[-200:]) / max(len(losses[-200:]), 1), 5),
            "pas_par_s": round(step / el, 3),
            "pas_par_s_hors_compil": round((step - 1) / (time.time() - t_first), 3) if t_first else None,
            "compilation_s": round(t_first - t_start, 1) if t_first else None, "batch": a.batch, "lr": a.lr,
            "echantillons_vus": step * a.batch, "epoques": round(step * a.batch / len(ds), 1),
            "grad_norm_debut": round(sum(gnorms[:200]) / max(len(gnorms[:200]), 1), 4),
            "grad_norm_fin": round(sum(gnorms[-200:]) / max(len(gnorms[-200:]), 1), 4),
            "grad_clip": a.grad_clip,
            "optimiseur": "Adam (comme la reference, pas AdamW)",
            "validation": "AUCUNE - entraine sur les 111 episodes (choix de Sam, comme la reference)",
            "precision": a.dtype,
            "lr_schedule": a.lr_schedule,
            "repris_de": a.init_from,
            "recette": "copie de cart_combined_128, mais LR CONSTANT + moyenne des derniers poids",
            "_stats": meta.stats}
    fmetrics.close()
    moy.snapshot(pol_raw)  # dernier point de la trajectoire
    save(pol_raw, ema, cfg, outdir, info, moy=moy)
    log(f"    [{nom}] TERMINE : {step} pas ({info['epoques']} epoques) en {el/60:.1f} min | "
        f"loss {info['loss_debut']:.5f} -> {info['loss_fin']:.5f} | {outdir}")

    del pol, pol_raw, fwd, opt, dl, ds, ema
    torch.xpu.empty_cache()
    return info


def main():
    p = argparse.ArgumentParser()
    p.add_argument("--root", required=True)
    p.add_argument("--out", required=True)
    p.add_argument("--hours", type=float, default=3.0)
    p.add_argument("--batch", type=int, default=64)
    p.add_argument("--workers", type=int, default=12)
    p.add_argument("--lr", type=float, default=1e-4)
    p.add_argument("--dtype", default="bf16", choices=["bf16", "fp32"],
                   help="bf16 = rapide (x1.75) mais resolution grossiere ; "
                        "fp32 = comme la reference, plus lent")
    p.add_argument("--lr-schedule", default="constant", choices=["constant", "cosine"],
                   help="constant = entrainement principal ; cosine = COOLDOWN (LR vers 0)")
    p.add_argument("--init-from", default=None,
                   help="dossier d un balayage precedent ; reprend <init-from>/<taille>/pretrained_model")
    p.add_argument("--avg-last", type=int, default=8,
                   help="nb de derniers snapshots moyennes (remplace le cooldown)")
    p.add_argument("--grad-clip", type=float, default=10.0,
                   help="ecretage du gradient (10.0 = valeur de la reference)")
    p.add_argument("--metrics-every", type=int, default=10,
                   help="1 ligne de metrics.csv tous les N pas")
    p.add_argument("--snap-every", type=float, default=15,
                   help="minutes entre 2 snapshots pour la moyenne")
    p.add_argument("--ema-decay", type=float, default=0.999)
    p.add_argument("--seed", type=int, default=42)
    p.add_argument("--save-every", type=float, default=30)
    p.add_argument("--log-every", type=float, default=180, help="secondes entre logs")
    p.add_argument("--no-compile", action="store_true")
    p.add_argument("--only", default=None)
    a = p.parse_args()

    outroot = Path(a.out).expanduser()
    outroot.mkdir(parents=True, exist_ok=True)
    logf = outroot / "sweep.log"

    def log(msg):
        print(msg, flush=True)
        with open(logf, "a") as f:
            f.write(msg + "\n")

    tailles = TAILLES
    if a.only:
        garder = {x.strip() for x in a.only.split(",")}
        tailles = [t for t in TAILLES if t[0] in garder]

    log(f"### BALAYAGE {len(tailles)} modeles x {a.hours} h = {len(tailles)*a.hours} h")
    log("### du plus GROS au plus petit ; recette copiee de cart_combined_128")

    res = []
    for nom, dd in tailles:
        try:
            res.append(train_one(nom, dd, a, log))
        except Exception as e:
            import traceback
            log(f"    [{nom}] ECHEC : {type(e).__name__}: {e}")
            log(traceback.format_exc()[-1500:])
        (outroot / "resultats.json").write_text(json.dumps(res, indent=2))

    log("\n" + "=" * 72 + "\n### RECAPITULATIF")
    log(f"{'modele':8s} {'params':>9s} {'pas':>8s} {'epoques':>8s} {'loss fin':>10s} {'pas/s':>8s}")
    for r in res:
        log(f"{r['nom']:8s} {r['params_M']:8.1f}M {r['steps']:8d} {r['epoques']:8.1f} "
            f"{r['loss_fin']:10.5f} {r['pas_par_s']:8.3f}")


if __name__ == "__main__":
    main()
